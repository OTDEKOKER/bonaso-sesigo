# Frontend-to-backend API target.
# Prefer NEXT_PUBLIC_API_URL for browser access, or BACKEND_API_URL when using Next rewrites.
NEXT_PUBLIC_API_URL=https://your-api-domain.example/api
NEXT_PUBLIC_API_BASE_URL=https://your-api-domain.example/api

# Optional server-side rewrite target. If set, /api/* is proxied here.
BACKEND_API_URL=https://your-api-domain.example/api

# Optional environment label.
NEXT_PUBLIC_ENV=production

# Optional service worker flag for development testing only.
NEXT_PUBLIC_ENABLE_SW=false

# Content-Security-Policy (audit S1). DISABLED by default — the header is only
# emitted when CONTENT_SECURITY_POLICY is a non-empty policy string, so leaving
# these unset changes nothing. Roll out with report-only first, then enforce.
# Applies to both the Next.js app pages and Django-served surfaces.
#   CONTENT_SECURITY_POLICY=default-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
#   CONTENT_SECURITY_POLICY_REPORT_ONLY=true
CONTENT_SECURITY_POLICY=
CONTENT_SECURITY_POLICY_REPORT_ONLY=false
