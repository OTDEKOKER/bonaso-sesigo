# ---- Secrets / environment ----
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ---- Python ----
**/venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- Ad-hoc scratch / one-off scripts (leading-underscore convention; not app code) ----
/backend/_*.py
/backend/scripts/_*.py
*.bak_*

# ---- Node / Next.js ----
**/node_modules/
**/.next/
**/out/
*.tsbuildinfo

# ---- Databases / dumps / backups ----
*.sqlite3
*.dump
*.sql
backend/backups/
# Root-level snapshot/rollback dumps and ad-hoc DB patch scripts written by
# remediation work (e.g. backups/kp_fix_*.json, backups/manual-patches/). These
# contain REAL programme data and must never be committed. Only backend/backups/
# was previously ignored, leaving the repo-root backups/ dir exposed.
/backups/
# Dated read-only audit artefact dirs dropped at the repo root (jsonl/csv dumps
# of real programme data — e.g. audit_2026-06-22/).
/audit_[0-9]*/
*.bak
.git.broken*/

# ---- Runtime state / user content ----
backend/media/
backend/staticfiles/
training/state/

# uploads/ mixes the Django app code with runtime import artifacts (JSON dumps
# that may contain real programme data). The app code MUST stay tracked: it is
# bind-mounted over the image at runtime, so if a checkout/worktree lacks it the
# mount shadows the baked-in code and every API endpoint 500s (outage 2026-06-05).
# Allowlist: ignore everything under uploads/, then re-include only Python code.
backend/uploads/**
!backend/uploads/**/
!backend/uploads/**/*.py

# ---- Data exports / audit artifacts (may contain real programme data) ----
*.jsonl
*.csv
*.xlsx
*.xlsm
*.pptx
*.docx
/imports/
downloads/

# ---- Logs / OS ----
*.log
.DS_Store

# ---- Data output / fixture dirs (real programme data — never commit) ----
backend/data/
backend/reports/
backend/uploads/*.json
backend/uploads/import-backups/
backend/uploads/**/*.bak-*
frontend/reports/
frontend/scripts/reports/

# Spreadsheet source data (may contain real programme data)
*.ods
