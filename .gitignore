# ---- Secrets / environment ----
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ---- Python ----
**/venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- Node / Next.js ----
**/node_modules/
**/.next/
**/out/
*.tsbuildinfo

# ---- Databases / dumps / backups ----
*.sqlite3
*.dump
*.sql
backend/backups/
*.bak
.git.broken*/

# ---- Runtime state / user content ----
backend/media/
backend/staticfiles/
training/state/

# ---- Data exports / audit artifacts (may contain real programme data) ----
*.jsonl
*.csv
*.xlsx
*.xlsm
*.pptx
*.docx
/imports/
downloads/

# ---- Logs / OS ----
*.log
.DS_Store

# ---- Data output / fixture dirs (real programme data — never commit) ----
backend/data/
backend/reports/
backend/uploads/*.json
backend/uploads/import-backups/
backend/uploads/**/*.bak-*
frontend/reports/
frontend/scripts/reports/

# Spreadsheet source data (may contain real programme data)
*.ods
